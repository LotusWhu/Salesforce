# 数据库
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/renrenbang?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"

# Twilio (短信验证码)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Google Calendar OAuth (上门服务预约同步日程)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URL="http://localhost:3001/users/me/google-calendar/callback"

# Stripe (支付/服务费/担保交易)
STRIPE_SECRET_KEY=""

PORT=3001
NODE_ENV=development
