{
  "name": "renrenbang",
  "private": true,
  "version": "0.1.0",
  "description": "华人生活服务平台 - 任务外包/上门服务/拼车接送机/分类信息",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @renrenbang/api dev",
    "dev:web": "pnpm --filter @renrenbang/web dev",
    "dev:mobile": "pnpm --filter @renrenbang/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
